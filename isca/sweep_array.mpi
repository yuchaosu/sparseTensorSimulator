#!/bin/bash
#SBATCH -J hbm_sweep
#SBATCH -o sweep_%A_%a.out
#SBATCH -e sweep_%A_%a.err
#SBATCH --partition=turin         # multi-node partition (15 nodes); array spreads across them
#SBATCH -N 1
#SBATCH -n 1
#SBATCH -c 2
#SBATCH -t 04:00:00
# NB: this cluster does not schedule on memory (RealMemory=1), so do NOT add
# --mem (it fails with "Memory specification can not be satisfied"). Concurrency
# is bounded by cores (-c) and the array %limit instead.

# One array task = one run from isca/manifest.txt (line = SLURM_ARRAY_TASK_ID+1).
# Submitted by isca/submit_sweep.sh, which sizes the array to the manifest.
set -u
# $0 points at SLURM's spool copy inside a batch job, so take the repo path from
# the environment (exported by submit_sweep.sh), with an absolute fallback.
REPO="${SWEEP_REPO:-/home/ysu34/DIAMOND/sparseTensorSimulator}"
MAN="$REPO/isca/manifest.txt"
BIN="$REPO/outputs/HBMHamiltonian"
ROWDIR="$REPO/isca/sweep_rows"
PER_RUN_TIMEOUT=10800             # 3h per run

module load gnu12/12.4.0 2>/dev/null || true
export LD_LIBRARY_PATH="$REPO/external/ramulator2:${LD_LIBRARY_PATH:-}"
mkdir -p "$ROWDIR"

line=$(sed -n "$((SLURM_ARRAY_TASK_ID + 1))p" "$MAN")
[ -z "$line" ] && { echo "no manifest line $SLURM_ARRAY_TASK_ID"; exit 0; }
set -- $line
folder=$1 file=$2 q=$3 grid=$4 it=$5 vf=$6 re=$7 ct=$8 ba=$9

echo "task $SLURM_ARRAY_TASK_ID: $folder$file q=$q grid=${grid}x${grid} iter=$it verify=$vf reuse=$re ctile=$ct balance=$ba"
timeout "$PER_RUN_TIMEOUT" "$BIN" -row="$grid" -col="$grid" \
    -folder="$folder" -file="$file" -qubit="$q" -iter="$it" -verify="$vf" \
    -reuse="$re" -ctile="$ct" -balance="$ba" \
    -csv="$ROWDIR/row_${SLURM_ARRAY_TASK_ID}.csv"
rc=$?
[ $rc -ne 0 ] && echo "task $SLURM_ARRAY_TASK_ID exit $rc (timeout/error): $folder$file grid=$grid"
exit 0
